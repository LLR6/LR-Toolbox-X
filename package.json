{
  "name": "lr-toolbox-x",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/studio-assets.mjs && tsc --noEmit && vite build && node scripts/licenses.mjs && node scripts/offline.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "catalog": "node --experimental-strip-types scripts/catalog.ts",
    "cli": "node --experimental-strip-types apps/cli/lrtool.ts",
    "desktop": "cd apps/desktop && tauri dev",
    "desktop:build": "cd apps/desktop && tauri build",
    "e2e": "playwright test",
    "cli:build": "node scripts/build-cli.mjs",
    "predev": "node scripts/studio-assets.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@stackline/xlsx": "1.0.9",
    "@tauri-apps/api": "2.12.4",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxing/browser": "0.2.1",
    "ajv": "8.20.0",
    "bwip-js": "4.11.4",
    "chrono-node": "2.10.1",
    "colorthief": "3.5.0",
    "compressorjs": "1.4.0",
    "cron-parser": "5.10.2",
    "cropperjs": "2.3.1",
    "dayjs": "1.11.23",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "exifreader": "4.51.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "fuse.js": "7.5.0",
    "heic2any": "0.0.4",
    "html2canvas": "1.4.1",
    "js-yaml": "5.5.0",
    "jsondiffpatch": "0.7.6",
    "jsonrepair": "3.15.0",
    "katex": "0.19.0",
    "libphonenumber-js": "1.13.15",
    "lottie-web": "5.13.0",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "mathjs": "15.2.0",
    "mermaid": "12.2.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "qrcode-generator": "2.0.4",
    "quicktype-core": "26.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sql-formatter": "15.9.0",
    "sql.js": "1.15.1",
    "svgo": "4.1.0",
    "tesseract.js": "7.0.0",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@ffmpeg/core": "0.12.10",
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sql.js": "1.4.11",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.0",
