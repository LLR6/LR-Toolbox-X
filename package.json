{
  "name": "lr-toolbox-x",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/licenses.mjs && node scripts/offline.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "catalog": "node --experimental-strip-types scripts/catalog.ts",
    "cli": "node --experimental-strip-types apps/cli/lrtool.ts",
    "desktop": "cd apps/desktop && tauri dev",
    "desktop:build": "cd apps/desktop && tauri build",
    "e2e": "playwright test",
    "cli:build": "node scripts/build-cli.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "ajv": "8.20.0",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "js-yaml": "5.5.0",
    "marked": "18.1.1",
    "qrcode-generator": "2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "jsqr": "1.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7"
  },
  "license": "Apache-2.0"
}
